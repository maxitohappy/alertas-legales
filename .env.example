# Copie este archivo a .env y complete los valores. NUNCA suba .env a GitHub.
ENVIRONMENT=development            # production en el servidor
FIRM_NAME=Estudio Jurídico Ejemplo
APP_BASE_URL=http://localhost:8000

# Genere con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Genere con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Local: sqlite:///./dev.db   |   Producción (Neon): postgresql://usuario:clave@host/db?sslmode=require
DATABASE_URL=sqlite:///./dev.db

TIMEZONE=Europe/Madrid
# Comunidad autónoma para festivos (MD=Madrid, CT=Cataluña, AN=Andalucía, VC=Valencia...). Vacío = solo nacionales
HOLIDAYS_SUBDIV=MD

# Gmail / Google Workspace: use una "contraseña de aplicación" (requiere 2FA en la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Correos del estudio que reciben el resumen diario (separados por coma)
FIRM_ALERT_EMAILS=

# Almacenamiento de documentos: local | s3 (Cloudflare R2, AWS S3, etc.)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

UPLOAD_MAX_MB=10
UPLOAD_TOKEN_DAYS=7
SESSION_IDLE_MINUTES=30

# Solo para scripts/seed_demo.py: correo usado como cliente demo
DEMO_EMAIL=
